<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_snippet_card_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <FrameLayout
            android:id="@+id/widget_header_bubble"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_bubble_bg">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@string/widget_bubble_open_desc"
                android:src="@drawable/ic_widget_bubble_mark" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tasks To Do"
                android:textColor="#141B29"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_header_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap bubble for full snippet"
                android:textColor="#535E73"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_header_count"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:background="@drawable/widget_badge_bg"
            android:gravity="center"
            android:minWidth="24dp"
            android:paddingHorizontal="7dp"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ListView
        android:id="@+id/widget_task_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="6dp"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/widget_empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="16dp"
        android:text="All caught up! Tap to add or review tasks."
        android:textColor="#535E73"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
